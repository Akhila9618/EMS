package com.example.api_gateway.filters;

import java.time.LocalDateTime;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.cloud.gateway.filter.GlobalFilter;
import org.springframework.context.annotation.Bean;
import org.springframework.stereotype.Component;

import com.example.api_gateway.config.GatewayConfig;

@Component
public class RequestLoginFilter {


//	this contains the thing that to get executed for every request

	private static final Logger logger = LoggerFactory.getLogger(GatewayConfig.class);

//	this gets executed for every received request
	@Bean
	public GlobalFilter requestLoginFilter() {
		return (exchange, chain) -> {
			logger.info("----------------------");
			logger.info("Request received");
			logger.info("Path : {}", exchange.getRequest().getPath());
			logger.info("Method : {}", exchange.getRequest().getMethod());
			logger.info("Time : {}", LocalDateTime.now());

			logger.info("----------------------------------------");

			return chain.filter(exchange);
		};
	}
}
