spring:
  application:
    name: api-gateway
  cloud:
    gateway:
      server:
        webflus:
          globalcors:
            add-to-simple-url-handler-mapping: true
            cors-configuration:
              '[/**]':
                allowedOrigins:
                  -"*"
             allowedMethods:
                  - GET
                  - POST
                  - PUT
                  - DELETE
                  - OPTIONS
                  - PATCH

                allowedHeaders:
                  - "*"

                exposedHeaders:
                  - Authorization